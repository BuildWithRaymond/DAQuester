+std::wstring inheritedHostPipe() {
+    SetLastError(ERROR_SUCCESS);
+    const auto size = GetEnvironmentVariableW(L"DAQUESTER_LAUNCH_PIPE", nullptr, 0);
+    if (!size && GetLastError() == ERROR_ENVVAR_NOT_FOUND)
+        return {};
+    if (!size || size > 128)
+        return L"invalid";
+    std::wstring value(size, L'\0');
+    const auto copied = GetEnvironmentVariableW(L"DAQUESTER_LAUNCH_PIPE", value.data(), size);
+    if (!copied || copied >= size)
+        return L"invalid";
+    value.resize(copied);
+    return value;
+}
+
+DWORD transferHostWord(HANDLE pipe, HANDLE event, bool writing, DWORD& value) noexcept {
+    ResetEvent(event);
+    OVERLAPPED operation{};
+    operation.hEvent = event;
+    DWORD count = 0;
+    const auto started = writing ? WriteFile(pipe, &value, sizeof(value), &count, &operation)
+                                 : ReadFile(pipe, &value, sizeof(value), &count, &operation);
+    if (!started && GetLastError() != ERROR_IO_PENDING)
+        return GetLastError();
+    const auto wait = WaitForSingleObject(event, 25000);
+    if (wait != WAIT_OBJECT_0) {
+        const auto error = wait == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError();
+        CancelIoEx(pipe, &operation);
+        // Keep the OVERLAPPED buffer alive until cancellation is acknowledged.
+        GetOverlappedResult(pipe, &operation, &count, TRUE);
+        return error;
+    }
+    if (!GetOverlappedResult(pipe, &operation, &count, FALSE))
+        return GetLastError();
+    return count == sizeof(value) ? ERROR_SUCCESS : ERROR_BAD_LENGTH;
+}
+
+LaunchResult requestHostLaunch(const std::wstring& name) noexcept {
+    LaunchResult result{ERROR_INVALID_NAME, LaunchStage::createProcess};
+    constexpr wchar_t prefix[] = L"DAQuester.NewClient.";
+    constexpr auto prefixSize = (sizeof(prefix) / sizeof(wchar_t)) - 1;
+    if (name.size() != prefixSize + 32 || name.compare(0, prefixSize, prefix) != 0 ||
+        name.find_first_not_of(L"0123456789abcdef", prefixSize) != std::wstring::npos)
+        return result;
+    try {
+        const auto path = std::wstring(L"\\\\.\\pipe\\") + name;
+        auto open = [&]() {
+            return CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr,
+                               OPEN_EXISTING, FILE_FLAG_OVERLAPPED | SECURITY_SQOS_PRESENT |
+                                                  SECURITY_IDENTIFICATION, nullptr);
+        };
+        auto pipe = open();
+        if (pipe == INVALID_HANDLE_VALUE && GetLastError() == ERROR_PIPE_BUSY &&
+            WaitNamedPipeW(path.c_str(), 1500))
+            pipe = open(); // Connection only; a submitted request is never replayed.
+        if (pipe == INVALID_HANDLE_VALUE) {
+            result.error = GetLastError();
+            return result;
+        }
+        auto event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        if (!event) {
+            result.error = GetLastError();
+            CloseHandle(pipe);
+            return result;
+        }
+        DWORD word = 0x31585144; // DQX1: request one blank managed login window.
+        result.error = transferHostWord(pipe, event, true, word);
+        if (!result.error) {
+            result.error = transferHostWord(pipe, event, false, word);
+            if (!result.error)
+                result.error = word;
+        }
+        CloseHandle(event);
+        CloseHandle(pipe);
+        return result;
+    } catch (const std::bad_alloc&) {
+        result.error = ERROR_NOT_ENOUGH_MEMORY;
+        return result;
+    }
+}
