<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>BuildWithRaymond</Authors>
    <RepositoryUrl>https://github.com/BuildWithRaymond/DAQuester</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts\packages</RestorePackagesPath>
    <RestoreAdditionalProjectFallbackFolders>$(UserProfile)\.nuget\packages</RestoreAdditionalProjectFallbackFolders>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
