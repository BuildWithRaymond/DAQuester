<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.7.2</Version>
    <Authors>BuildWithRaymond</Authors>
    <RepositoryUrl>https://github.com/BuildWithRaymond/DAQuester</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts\packages</RestorePackagesPath>
    <RestoreAdditionalProjectFallbackFolders Condition="Exists('$(UserProfile)\.nuget\packages')">$(UserProfile)\.nuget\packages</RestoreAdditionalProjectFallbackFolders>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
