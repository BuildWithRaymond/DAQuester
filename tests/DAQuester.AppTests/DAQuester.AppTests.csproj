<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>true</SelfContained>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the exact broker engine for in-process contract checks without
         bringing its ASP.NET hosting runtime into the desktop application. -->
    <Compile Include="../../integrations/aislingexchange/src/BrokerEngine*.cs" Link="BrokerContract/%(Filename)%(Extension)" />
    <Compile Include="../../integrations/aislingexchange/src/Contracts.cs" Link="BrokerContract/Contracts.cs" />
    <Compile Include="../../integrations/aislingexchange/src/StateStore.cs" Link="BrokerContract/StateStore.cs" />
    <Content Include="../../artifacts/native/DAWindowerX/output/WindowingFixture.exe">
      <Link>WindowingFixture.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <ProjectReference Include="../../src/DAQuester.App/DAQuester.App.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="PrepareWindowingFixture" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Build-DAWindowerX.ps1&quot; -IncludeTestFixture" />
  </Target>
</Project>
