<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>DAQuester</AssemblyName>
    <ApplicationIcon>Assets\daquester.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\artifacts\native\DAWindowerX\output\DAWindowerX.dll">
      <Link>DAWindowerX.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\artifacts\native\DAWindowerX\output\source.json">
      <Link>licenses\DAWindowerX\source.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <AvaloniaResource Include="Assets\daquester.ico;Assets\daquester.png"/>
    <ProjectReference Include="..\DAQuester.DarkAges\DAQuester.DarkAges.csproj"/>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12"/>
    <!-- BuildServices supplies optional telemetry; XAML compilation comes from Avalonia itself. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all"/>
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0"/>
    <PackageReference Include="Velopack" Version="1.2.161"/>
    <Content Include="Licenses\**\*">
      <Link>licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\content\**\*">
      <Link>content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\DAQuester.DarkAges\Vendor\ARBITER-LICENSE.txt">
      <Link>ARBITER-LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\LICENSE;..\..\THIRD_PARTY_NOTICES.md">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\package-readme.md">
      <Link>README.md</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\releases\v$(Version).md">
      <Link>RELEASE_NOTES.md</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="PrepareDAWindowerX" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Build-DAWindowerX.ps1&quot;" />
  </Target>
</Project>
