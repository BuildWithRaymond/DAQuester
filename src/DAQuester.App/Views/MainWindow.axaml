<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:DAQuester.App.Controls" x:Class="DAQuester.App.Views.MainWindow" x:CompileBindings="False" Title="DAQuester" Width="1420" Height="900" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <controls:InverseBooleanConverter x:Key="Not"/>
    <controls:ObjectPresenceConverter x:Key="Present"/>
  </Window.Resources>
  <Grid ColumnDefinitions="180,*" Name="shell">
    <Border Grid.Column="0" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,26,12,18">
        <StackPanel Margin="6,0,0,30" Spacing="9">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Image Width="24" Height="24" Source="avares://DAQuester/Assets/daquester.png"/>
            <TextBlock Name="brandName" Text="DAQuester" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Name="brandSubtitle" Text="DARK AGES COMPANION" FontSize="9" LetterSpacing="1.25" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="6">
          <Button Name="navPlanner" Classes="nav" Classes.active="{Binding IsPlanner}" Command="{Binding NavigateCommand}" CommandParameter="Planner" ToolTip.Tip="Quest planner">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:LineIcon Width="17" Height="17" Icon="BookOpen"/>
              <TextBlock Classes="navLabel" Text="Quest planner"/>
            </StackPanel>
          </Button>
          <Button Name="navCharacters" Classes="nav" Classes.active="{Binding IsCharacters}" Command="{Binding NavigateCommand}" CommandParameter="Characters" ToolTip.Tip="Characters">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:LineIcon Width="17" Height="17" Icon="Users"/>
              <TextBlock Classes="navLabel" Text="Characters"/>
            </StackPanel>
          </Button>
          <Button Name="navHistory" Classes="nav" Classes.active="{Binding IsHistory}" Command="{Binding NavigateCommand}" CommandParameter="History" ToolTip.Tip="Run history">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:LineIcon Width="17" Height="17" Icon="RotateCcw"/>
              <TextBlock Classes="navLabel" Text="Run history"/>
            </StackPanel>
          </Button>
          <Button Name="navSettings" Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip.Tip="Settings">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:LineIcon Width="17" Height="17" Icon="Settings"/>
              <TextBlock Classes="navLabel" Text="Settings"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="18">
          <StackPanel Name="railSaveNote" Orientation="Horizontal" Spacing="8" Margin="7,0">
            <controls:LineIcon Width="15" Height="15" Foreground="{DynamicResource Ready}" Icon="ShieldCheck"/>
            <TextBlock Text="Progress stays with&#10;your character" Classes="caption"/>
          </StackPanel>
          <Button Name="stopAll" Classes="danger railAction" Command="{Binding StopAllCommand}" ToolTip.Tip="Stop all quests and keep progress">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LineIcon Width="13" Height="13" Icon="Square"/>
              <TextBlock Name="stopAllText" Text="Stop all quests"/>
            </StackPanel>
          </Button>
          <TextBlock Name="railVersion" Text="{Binding VersionText}" Classes="caption" FontSize="10" Margin="8,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="24,22,24,12" Name="mainWorkspace">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="{Binding PageTitle}" Classes="heading"/>
          <TextBlock Name="pageSubtitle" Text="{Binding PageSubtitle}" Classes="muted" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="20,0,0,0">
          <Button Name="launchSelected" Classes="workspaceHeader" Content="Launch" Command="{Binding LaunchSelectedCommand}" ToolTip.Tip="{Binding LaunchTooltip}" ToolTip.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding LaunchTooltip}"/>
          <ComboBox Name="characterSwitcher" Classes="workspaceHeader" MinWidth="215" MaxWidth="285" Padding="10,4" ItemsSource="{Binding SwitcherCharacters}" SelectedItem="{Binding SelectedCharacter,Mode=TwoWay}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Selected character">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="32,*" ColumnSpacing="9" VerticalAlignment="Center">
                  <controls:CharacterSpritePreview IsPortrait="True" Snapshot="{Binding PortraitCharacter}" RememberedAppearance="{Binding RememberedAppearance}" GameDirectory="{Binding PortraitGameDirectory}" Width="32" Height="32" AutomationProperties.Name="{Binding DisplayName,StringFormat='Portrait of {0}'}"/>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LevelText}" Classes="caption" FontSize="10" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1">
        <Border Name="errorBanner" IsVisible="{Binding HasError}" Background="{DynamicResource ErrorSurface}" BorderBrush="{DynamicResource ErrorLine}" BorderThickness="1" CornerRadius="7" Padding="14,10" Margin="0,0,0,16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="quiet" Content="Dismiss" Command="{Binding DismissErrorCommand}"/>
          </Grid>
        </Border>
        <Border Name="noticeBanner" IsVisible="{Binding HasNotice}" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="1" CornerRadius="7" Padding="14,10" Margin="0,0,0,16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding NoticeMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="quiet" Content="Dismiss" Command="{Binding DismissNoticeCommand}"/>
          </Grid>
        </Border>
      </StackPanel>
      <Grid Grid.Row="2" Name="plannerPage" IsVisible="{Binding IsPlanner}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Name="plannerLayout" RowDefinitions="Auto,*" RowSpacing="12" MinHeight="620" Height="{Binding Bounds.Height,ElementName=plannerPage}">
            <Border Name="journeyCard" Classes="card" Height="270" ClipToBounds="True">
              <Grid>
                <Grid Name="journeyLayout" VerticalAlignment="Top" ColumnDefinitions="*,18,346">
                  <Border Padding="16,14,16,14" CornerRadius="8,0,0,8" Background="{DynamicResource JourneyBackdrop}" ClipToBounds="True">
                    <Grid>
                      <controls:CharacterSpriteAccent Source="{Binding ElementName=journeySprite}" Opacity="0.12" IsHitTestVisible="False"/>
                      <ScrollViewer Name="journeyOverview" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,112" RowSpacing="8" ColumnSpacing="12" Height="{Binding Viewport.Height,ElementName=journeyOverview}">
                          <StackPanel Grid.ColumnSpan="2" Spacing="7">
                            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
                              <controls:QuestGlyph QuestId="{Binding JourneyIcon}" Width="28" Height="28" Foreground="{DynamicResource Gold}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="CURRENT JOURNEY" FontSize="10" LetterSpacing="1.2" Classes="muted"/>
                                <TextBlock Text="{Binding JourneyTitle}" FontFamily="Georgia" FontSize="22" LineHeight="27" TextWrapping="Wrap"/>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding JourneyState}" Classes="gold" FontSize="11" MaxWidth="160" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding JourneyMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="5" VerticalAlignment="Center">
                            <controls:QuestTrail Name="journeyProgress" Steps="{Binding JourneySteps}" IsRunning="{Binding JourneyAnimating}" Height="28" AutomationProperties.Name="{Binding JourneySteps.Label}"/>
                            <TextBlock Text="{Binding JourneySteps.Label}" FontSize="12"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,124,0">
                              <TextBlock Text="{Binding JourneyNext}" Classes="caption" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0"/>
                              <TextBlock Text="{Binding JourneyRewards}" Classes="caption ready" FontSize="11" TextWrapping="Wrap"/>
                            </WrapPanel>
                          </StackPanel>
                          <StackPanel Grid.Row="2" Name="journeyControls" Spacing="6" VerticalAlignment="Bottom">
                            <WrapPanel Orientation="Horizontal">
                              <CheckBox Content="{Binding FastModeLabel}" IsChecked="{Binding FastMode,Mode=TwoWay}" Margin="0,0,14,0"/>
                              <CheckBox Content="{Binding RepeatLabel}" IsChecked="{Binding Repeat,Mode=TwoWay}" IsVisible="{Binding RepeatVisible}" IsEnabled="{Binding RepeatEnabled}"/>
                              <Button Name="changeChoices" Classes="quiet" Content="Change choices" Command="{Binding ChangeChoicesCommand}" IsVisible="{Binding ChangeChoicesVisible}" MinHeight="28" FontSize="12" Padding="8,4"/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                              <Button Name="startQuest" Classes="journeyAction" Command="{Binding StartQuestCommand}" Margin="0,0,6,4" ToolTip.Tip="{Binding StartQuestLabel}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding StartQuestLabel}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <Grid Width="20" Height="20">
                                    <controls:LineIcon Icon="ScrollText" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <controls:LineIcon Icon="Play" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                  </Grid>
                                  <TextBlock Classes="journeyActionLabel" Text="{Binding StartQuestLabel}"/>
                                </StackPanel>
                              </Button>
                              <Button Name="resumeQuest" Classes="journeyAction" Command="{Binding ResumeQuestCommand}" Margin="0,0,6,4" ToolTip.Tip="Resume saved individual quest" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Resume individual quest">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <controls:LineIcon Icon="Play" Width="20" Height="20"/>
                                  <TextBlock Classes="journeyActionLabel" Text="Resume"/>
                                </StackPanel>
                              </Button>
                              <Button Name="pauseQuest" Classes="journeyAction" Command="{Binding PauseQuestCommand}" Margin="0,0,6,4" ToolTip.Tip="Pause individual quest" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Pause individual quest">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <controls:LineIcon Icon="Pause" Width="20" Height="20"/>
                                  <TextBlock Classes="journeyActionLabel" Text="Pause"/>
                                </StackPanel>
                              </Button>
                              <Button Name="stopQuest" Classes="journeyAction" Command="{Binding StopQuestCommand}" Margin="0,0,6,4" ToolTip.Tip="Stop individual quest · progress saved" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Stop individual quest">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <controls:LineIcon Icon="Square" Width="20" Height="20"/>
                                  <TextBlock Classes="journeyActionLabel" Text="Stop"/>
                                </StackPanel>
                              </Button>
                              <Button Name="addJourneyToQueue" Classes="journeyAction" Command="{Binding AddJourneyToQueueCommand}" Margin="0,0,0,4" ToolTip.Tip="{Binding AddJourneyToQueueLabel}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Add this quest to queue">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <Grid Width="20" Height="20">
                                    <controls:LineIcon Icon="ListOrdered" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <controls:LineIcon Icon="Plus" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                  </Grid>
                                  <TextBlock Classes="journeyActionLabel" Text="{Binding AddJourneyToQueueLabel}"/>
                                </StackPanel>
                              </Button>
                            </WrapPanel>
                          </StackPanel>
                          <controls:CharacterSpritePreview Name="journeySprite" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Snapshot="{Binding JourneyCharacter}" RememberedAppearance="{Binding JourneyRememberedAppearance}" GameDirectory="{Binding JourneyGameDirectory}" VerticalAlignment="Bottom" AutomationProperties.Name="Character preview"/>
                        </Grid>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                  <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="16,0,0,0" Margin="0,10,14,10">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="4">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,36,0">
                        <StackPanel Spacing="3" ToolTip.Tip="{Binding QueueHint}">
                          <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                            <controls:LineIcon Icon="ListOrdered" Width="18" Height="18" Foreground="{DynamicResource Gold}"/>
                            <TextBlock Grid.Column="1" Text="{Binding QueueHeading}" Classes="section" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          </Grid>
                          <TextBlock Text="{Binding QueueSummary}" Classes="caption" FontSize="10" Margin="26,0,0,0"/>
                        </StackPanel>
                        <Button Name="queueClear" Grid.Column="1" Classes="quiet" Content="Clear" Command="{Binding ClearQueueCommand}" MinHeight="28" Padding="8,3"/>
                      </Grid>
                      <Grid Grid.Row="1">
                        <ScrollViewer Name="queueScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                          <ItemsControl Name="queueList" ItemsSource="{Binding QueueItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                  <Border Name="queueRow" Classes="queueRow" Classes.active="{Binding IsActive}" Focusable="True" KeyDown="QueueKeyDown" AutomationProperties.Name="{Binding Name,StringFormat='Queue item {0}'}">
                                    <Grid ColumnDefinitions="12,16,*,Auto" ColumnSpacing="6">
                                      <Border Name="queueGrip" Background="Transparent" Cursor="SizeAll" PointerPressed="QueuePointerPressed" PointerMoved="QueuePointerMoved" PointerReleased="QueuePointerReleased" PointerCaptureLost="QueuePointerCaptureLost" ToolTip.Tip="Drag to reorder. Ctrl+Up or Ctrl+Down also moves this quest.">
                                        <controls:GripGlyph Width="10" Height="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                      </Border>
                                      <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="11" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                      <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="icon queueAction" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Move up" AutomationProperties.Name="{Binding Name,StringFormat='Move up {0}'}">
                                          <controls:LineIcon Width="12" Height="12" Icon="ArrowUp"/>
                                        </Button>
                                        <Button Classes="icon queueAction" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Move down" AutomationProperties.Name="{Binding Name,StringFormat='Move down {0}'}">
                                          <controls:LineIcon Width="12" Height="12" Icon="ArrowDown"/>
                                        </Button>
                                        <Button Classes="icon queueAction" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Remove from queue" AutomationProperties.Name="{Binding Name,StringFormat='Remove {0}'}">
                                          <controls:LineIcon Width="11" Height="11" Icon="X"/>
                                        </Button>
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                  <Border Name="insertionBefore" Background="{DynamicResource Gold}" Height="3" VerticalAlignment="Top" IsVisible="False" IsHitTestVisible="False"/>
                                  <Border Name="insertionAfter" Background="{DynamicResource Gold}" Height="3" VerticalAlignment="Bottom" IsVisible="False" IsHitTestVisible="False"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <StackPanel IsVisible="{Binding QueueEmpty}" Margin="12,16" Spacing="7">
                          <TextBlock Text="Plan your next journey" FontSize="14" FontWeight="SemiBold"/>
                          <TextBlock Text="Select quests in the library to add them to this character’s queue." Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                      <TextBlock Grid.Row="2" Text="{Binding QueueReadiness}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                      <StackPanel Grid.Row="3" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <Button Name="queueStart" Classes="primary queuePrimary" Command="{Binding StartQueueCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="{Binding QueuePrimaryTooltip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding QueuePrimaryLabel}" AutomationProperties.HelpText="{Binding QueuePrimaryTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <controls:LineIcon Icon="{Binding QueuePrimaryIcon}" Width="20" Height="20"/>
                              <TextBlock Text="{Binding QueuePrimaryLabel}"/>
                            </StackPanel>
                          </Button>
                          <Button Name="queueStop" Grid.Column="1" Content="Stop" Command="{Binding StopQueueCommand}" MinHeight="42" ToolTip.Tip="Stop the queue; progress stays saved" ToolTip.ShowOnDisabled="True"/>
                        </Grid>
                        <Button Name="addQuestsToQueue" Classes="quiet" HorizontalAlignment="Stretch" MinHeight="28" Padding="10,4" Click="AddQuestsToQueue" AutomationProperties.Name="Add quests to queue">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:LineIcon Icon="Plus" Width="12" Height="12" Foreground="{DynamicResource Muted}"/>
                            <TextBlock Text="Add quests to queue" FontSize="12"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Name="journeyMiniBar" IsVisible="False" VerticalAlignment="Top" Height="56" ColumnDefinitions="28,*,Auto" RowDefinitions="Auto,Auto,*" ColumnSpacing="12" RowSpacing="3" Margin="16,12,56,10">
                  <controls:QuestGlyph QuestId="{Binding JourneyIcon}" Grid.RowSpan="2" Width="24" Height="24" Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/>
                  <TextBlock Name="compactJourneyTitle" Grid.Column="1" Text="{Binding JourneyTitle}" FontFamily="Georgia" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding JourneyTitle}"/>
                  <TextBlock Name="compactJourneySummary" Grid.Column="1" Grid.Row="1" Text="{Binding CompactJourneySummary}" Classes="caption" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CompactJourneySummary}"/>
                  <StackPanel Grid.Column="2" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding CompactQueueControls}">
                    <Button Name="compactQueueStart" Classes="primary queuePrimary" Command="{Binding StartQueueCommand}" ToolTip.Tip="{Binding QueuePrimaryTooltip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding QueuePrimaryLabel}" AutomationProperties.HelpText="{Binding QueuePrimaryTooltip}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon Icon="{Binding QueuePrimaryIcon}" Width="20" Height="20"/>
                        <TextBlock Text="{Binding QueuePrimaryLabel}"/>
                      </StackPanel>
                    </Button>
                    <Button Name="compactQueueStop" Content="Stop" Command="{Binding StopQueueCommand}" MinHeight="42" ToolTip.Tip="Stop the queue; progress stays saved" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Stop queue"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding CompactIndividualControls}">
                    <Button Name="compactIndividualPause" Command="{Binding PauseQuestCommand}" MinHeight="42" ToolTip.Tip="Pause individual quest" AutomationProperties.Name="Pause individual quest">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <controls:LineIcon Icon="Pause" Width="18" Height="18" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="Pause quest"/>
                      </StackPanel>
                    </Button>
                    <Button Name="compactIndividualStop" Content="Stop" Command="{Binding StopQuestCommand}" MinHeight="42" ToolTip.Tip="Stop individual quest; progress stays saved" AutomationProperties.Name="Stop individual quest"/>
                  </StackPanel>
                  <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding JourneyProgress}" IsVisible="{Binding JourneyHasSteps}" Minimum="0" Maximum="100" Height="3" VerticalAlignment="Bottom" Foreground="{DynamicResource Gold}" Background="{DynamicResource Line}" AutomationProperties.Name="{Binding JourneySteps.Label}" ToolTip.Tip="{Binding JourneySteps.Label}"/>
                </Grid>
                <controls:JourneyFoldAccent Name="journeyFold" IsHitTestVisible="False"/>
                <Button Name="journeyToggle" Classes="icon journeyToggle" Command="{Binding ToggleJourneyCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,12,12,12" ToolTip.Tip="{Binding JourneyToggleLabel}" AutomationProperties.Name="{Binding JourneyToggleLabel}">
                  <controls:LineIcon Name="journeyChevron" Icon="ChevronUp" Width="16" Height="16" Foreground="{DynamicResource Muted}"/>
                </Button>
              </Grid>
            </Border>
            <Border Classes="card" Grid.Row="1">
              <Grid RowDefinitions="Auto,*,Auto,Auto">
                <StackPanel Margin="16,16,16,12" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Quest library" Classes="section"/>
                    <TextBlock Grid.Column="1" Text="{Binding CompletedCount,StringFormat='{}{0} completed'}" Classes="caption ready" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBox Name="plannerSearch" Text="{Binding Search,Mode=TwoWay}" Watermark="Search quests, rewards, or requirements" AutomationProperties.Name="Search quests"/>
                  <WrapPanel Orientation="Horizontal">
                    <Button Name="filterAll" Classes="filter" Classes.active="{Binding IsAllFilter}" Command="{Binding FilterCommand}" CommandParameter="All" Margin="0,0,4,0">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="All quests"/>
                        <TextBlock Text="{Binding AllCount}" Opacity="0.7"/>
                      </StackPanel>
                    </Button>
                    <Button Name="filterQueueable" Classes="filter" Classes.active="{Binding IsQueueableFilter}" Command="{Binding FilterCommand}" CommandParameter="Can queue" Margin="0,0,4,0" ToolTip.Tip="Quests you can add to the queue, even before logging in. Connect this character and check requirements before running.">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Can queue"/>
                        <TextBlock Text="{Binding QueueableCount}" Opacity="0.7"/>
                      </StackPanel>
                    </Button>
                    <Button Name="filterReady" Classes="filter" Classes.active="{Binding IsReadyFilter}" Command="{Binding FilterCommand}" CommandParameter="Ready" Margin="0,0,4,0">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Ready"/>
                        <TextBlock Text="{Binding ReadyCount}" Opacity="0.7"/>
                      </StackPanel>
                    </Button>
                    <Button Name="filterCompleted" Classes="filter" Classes.active="{Binding IsCompletedFilter}" Command="{Binding FilterCommand}" CommandParameter="Completed" Margin="0,0,4,0">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Completed"/>
                        <TextBlock Text="{Binding CompletedCount}" Opacity="0.7"/>
                      </StackPanel>
                    </Button>
                    <Button Name="filterUnavailable" Classes="filter" Classes.active="{Binding IsUnavailableFilter}" Command="{Binding FilterCommand}" CommandParameter="Unavailable">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Unavailable"/>
                        <TextBlock Text="{Binding UnavailableCount}" Opacity="0.7"/>
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
                <Grid Grid.Row="1">
                  <ListBox Name="questLibrary" Classes="library" ItemsSource="{Binding Quests}" SelectedItem="{Binding SelectedQuest,Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Quest library">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                          <Border Classes="questRow" Width="{Binding $parent[ListBox].Bounds.Width}" HorizontalAlignment="Left" Classes.ready="{Binding RowReady}" Classes.muted="{Binding IsMuted}" Classes.completed="{Binding IsCompleted}" ToolTip.Tip="{Binding QueueTooltip}">
                          <Grid ColumnDefinitions="22,36,*,148" ColumnSpacing="10">
                            <Grid VerticalAlignment="Center">
                              <CheckBox IsChecked="{Binding IsQueued,Mode=TwoWay}" IsEnabled="{Binding CanQueue}" IsVisible="{Binding ShowQueueCheckbox}" MinHeight="28" Padding="0" ToolTip.Tip="{Binding QueueTooltip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding QueueActionName}" AutomationProperties.HelpText="{Binding QueueTooltip}"/>
                              <controls:LineIcon IsVisible="{Binding ShowCompletionCheck}" Width="17" Height="17" Foreground="{DynamicResource Ready}" Icon="Check"/>
                            </Grid>
                            <Border Grid.Column="1" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Width="36" Height="36" VerticalAlignment="Center">
                              <controls:QuestGlyph QuestId="{Binding Id}" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" Classes="questName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Rewards}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding SelectionExplanation}" Classes="caption" Classes.gold="{Binding StatusWarning}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Right">
                              <Border Classes="statusBadge" Classes.ready="{Binding StatusReady}" Classes.warning="{Binding StatusWarning}" ToolTip.Tip="{Binding SelectionExplanation}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <controls:LineIcon Icon="{Binding StatusIcon}" Width="13" Height="13" VerticalAlignment="Center"/>
                                  <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                              </Border>
                              <TextBlock Text="Queued" Foreground="{DynamicResource Gold}" FontSize="11" IsVisible="{Binding IsQueued}" HorizontalAlignment="Right"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel IsVisible="{Binding EmptyLibrary}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9" Margin="30">
                    <TextBlock Text="No matching quests" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try another name or choose All quests." Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding LibrarySelectionHint}" Classes="caption" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LibrarySummary}" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Expander Grid.Row="3" Name="questDetails" Header="Quest details" IsVisible="{Binding SelectedQuest,Converter={StaticResource Present}}" MaxHeight="300" IsExpanded="False" Margin="0" HorizontalAlignment="Stretch">
                  <ScrollViewer MaxHeight="235">
                    <StackPanel DataContext="{Binding SelectedQuest}" Spacing="9" Margin="16,5,16,16">
                      <TextBlock Text="{Binding Region}" Classes="eyebrow"/>
                      <TextBlock Text="{Binding Name}" Classes="section"/>
                      <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"/>
                      <Border Name="questNotice" Classes="callout" Classes.alert="{Binding NoticeAlert}" IsVisible="{Binding HasNotice}">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding NoticeTitle}" Classes="calloutTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding Level,StringFormat='Level: {0}'}" Classes="caption"/>
                      <TextBlock Text="{Binding Requirements}" Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Rewards,StringFormat='Rewards: {0}'}" Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Reason}" Classes="gold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Offerings}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasOfferings}"/>
                      <Button Content="Open quest guide" Command="{Binding OpenGuideCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </ScrollViewer>
                </Expander>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="2" Name="charactersPage" IsVisible="{Binding IsCharacters}" RowDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <Border Classes="card" IsVisible="{Binding CharactersEmpty}" Padding="32">
              <StackPanel Spacing="9">
                <TextBlock Text="Your next journey starts here" FontSize="20" FontFamily="Georgia"/>
                <TextBlock Text="Add a character name. Save a password for Launch, or sign in manually." Classes="muted" TextWrapping="Wrap"/>
                <Button Content="Add character" Command="{Binding AddCharacterCommand}" Classes="primary" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <ItemsControl Name="characterList" ItemsSource="{Binding Characters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Padding="18" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="14">
                      <controls:CharacterSpritePreview IsPortrait="True" Snapshot="{Binding PortraitCharacter}" RememberedAppearance="{Binding RememberedAppearance}" GameDirectory="{Binding PortraitGameDirectory}" Height="44" Width="44" AutomationProperties.Name="{Binding DisplayName,StringFormat='Portrait of {0}'}"/>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Name="cardLaunchStatus" Text="{Binding LaunchStatus}" Classes="caption" TextWrapping="Wrap"/>
                        <WrapPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding LevelText}" Classes="caption" Margin="0,0,16,0"/>
                          <TextBlock Text="{Binding LoginText}" Classes="caption"/>
                        </WrapPanel>
                      </StackPanel>
                      <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Name="launchCharacter" Content="Launch" Classes="primary" Command="{Binding LaunchCommand}" ToolTip.Tip="{Binding LaunchTooltip}" ToolTip.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding LaunchTooltip}" Margin="0,0,8,0"/>
                        <Button Classes="quiet" Content="Select" Command="{Binding SelectCommand}"/>
                      </WrapPanel>
                      <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="7">
                        <TextBlock Text="Character name" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="New password" Classes="caption"/>
                        <TextBox Grid.Row="1" Name="characterName" Text="{Binding Name,Mode=TwoWay}" Watermark="Character name" AutomationProperties.Name="Character name"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Password,Mode=TwoWay}" PasswordChar="●" Watermark="Leave blank to keep saved password" AutomationProperties.Name="New password"/>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6" Margin="0,5,0,0">
                          <TextBlock Text="{Binding LegendText}" Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Row="1" Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                        <Button Classes="quiet danger" Content="Remove" Command="{Binding RemoveCommand}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding AccountStatus}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Name="addCharacter" Content="Add character" Command="{Binding AddCharacterCommand}"/>
              <Button Content="Discard edits" Classes="quiet" Command="{Binding DiscardAccountsCommand}"/>
              <Button Name="saveAccounts" Content="Save accounts" Classes="primary" Command="{Binding SaveAccountsCommand}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" Name="historyPage" IsVisible="{Binding IsHistory}" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,15">
            <Grid ColumnDefinitions="150,*,145,145" ColumnSpacing="12">
              <TextBlock Text="Character" Classes="caption"/>
              <TextBlock Grid.Column="1" Text="Quest and result" Classes="caption"/>
              <TextBlock Grid.Column="2" Text="Outcome" Classes="caption"/>
              <TextBlock Grid.Column="3" Text="When" Classes="caption"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Name="runHistory" ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,16">
                      <Grid ColumnDefinitions="150,*,145,145" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <Grid Grid.RowSpan="2" ColumnDefinitions="32,*" ColumnSpacing="9" VerticalAlignment="Top">
                          <controls:CharacterSpritePreview IsPortrait="True" Snapshot="{Binding PortraitCharacter}" RememberedAppearance="{Binding RememberedAppearance}" GameDirectory="{Binding PortraitGameDirectory}" Width="32" Height="32" AutomationProperties.Name="{Binding Character,StringFormat='Portrait of {0}'}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Character}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Quest}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{Binding Outcome}" Classes="ready" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="{Binding When}" Classes="caption" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Summary}" Classes="caption" TextWrapping="Wrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel IsVisible="{Binding HistoryEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="30">
              <TextBlock Text="A journal of your journeys" FontFamily="Georgia" FontSize="21" HorizontalAlignment="Center"/>
              <TextBlock Text="Verified outcomes appear here after a quest attempt." Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,11">
            <TextBlock Text="Your journal records confirmed outcomes and completed attempts." Classes="caption"/>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="2" Name="settingsPage" IsVisible="{Binding IsSettings}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="12">
              <TextBlock Text="Game client" Classes="section"/>
              <TextBlock Text="Choose the Dark Ages application used by each character’s Launch button." Classes="caption" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Name="clientPath" Text="{Binding ClientPath,Mode=TwoWay}" Watermark="Choose a Dark Ages application" AutomationProperties.Name="Dark Ages application"/>
                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseClientCommand}"/>
              </Grid>
              <Button Name="saveSettings" Content="Save settings" Command="{Binding SaveSettingsCommand}" Classes="primary" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="13">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Application updates" Classes="section"/>
                <TextBlock Grid.Column="1" Text="{Binding VersionText}" Classes="caption"/>
              </Grid>
              <CheckBox Name="automaticUpdates" Content="Check for updates when DAQuester opens" IsChecked="{Binding AutomaticUpdateChecks,Mode=TwoWay}"/>
              <TextBlock Text="{Binding UpdateStatus}" Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel Orientation="Horizontal">
                <Button Name="checkUpdates" Content="Check for updates" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding CanCheckUpdates}" Margin="0,0,8,8"/>
                <Button Name="downloadUpdate" Content="Download update" Command="{Binding DownloadUpdateCommand}" IsEnabled="{Binding CanDownloadUpdate}" Margin="0,0,8,8"/>
                <Button Name="installUpdate" Content="Install and exit" Classes="primary" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" Margin="0,0,0,8"/>
              </WrapPanel>
              <TextBlock Text="Checks are optional. Download and install are separate choices. Finish quests and close launched game clients before installing." Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <TextBlock Text="{Binding ConnectionStatus}" Classes="caption" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <TextBlock Name="footerSaveNote" Grid.Column="1" Text="Progress saved for each character" Classes="caption" FontSize="11"/>
      </Grid>
    </Grid>
    <controls:CompletionEffectsLayer Name="completionEffects" Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False"/>
  </Grid>
</Window>
